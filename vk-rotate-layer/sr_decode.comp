#version 450
// The upscaled frame once, for a rectangle that is not its size (fit, fill, a TV): each of its OW x OH pixels from
// the NPU's output (luma, NC1HWC2 C2=16, channel dy*B+dx of a cell) and the native frame's colour (Cr,Cb,
// bilinear as align_corners=False) into an RGBA image, which sr_resample.frag then samples once a pixel,
// bilinearly, by the hardware. Run once a new NPU output, not once a present: rather than four luma fetches
// and their unpacking in each pixel of the picture (PSP on a 1080p TV: Mali 99%, 54 fps).
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, set = 0, binding = 0) readonly buffer Nout { uint w[]; } nout;
layout(set = 0, binding = 1) uniform mediump sampler2D cbcr;
layout(set = 0, binding = 2, rgba8) uniform writeonly mediump image2D rgb;
// the model's values (sr_rotate.frag's): as constants the divisions by B become multiplies
layout(constant_id = 0) const int B = 6;
layout(constant_id = 1) const int GH = 120;
layout(constant_id = 2) const int WSTRIDE = 200;
layout(constant_id = 3) const int ZP = -128;
layout(constant_id = 4) const float SCALE = 0.00392157;
layout(constant_id = 5) const int OW = 1200;
layout(constant_id = 6) const int OH = 720;

void main()
{
    ivec2 r = ivec2(gl_GlobalInvocationID.xy);
    if (r.x >= OW || r.y >= OH) return;
    ivec2 g = r / B;
    ivec2 in_cell = r - g * B;
    int c = in_cell.y * B + in_cell.x;
    uint word = nout.w[(((c >> 4) * GH + g.y) * WSTRIDE + g.x) * 4 + ((c & 15) >> 2)];
    int q = bitfieldExtract(int(word), (c & 3) * 8, 8);
    mediump float Y = clamp(float(q - ZP) * SCALE, 0.0, 1.0);
    mediump vec2 cc = texture(cbcr, (vec2(r) + 0.5) / vec2(OW, OH)).rg - 0.5;
    mediump float cr = cc.x, cb = cc.y;
    imageStore(rgb, r, vec4(clamp(vec3(Y + 1.403 * cr, Y - 0.714 * cr - 0.344 * cb, Y + 1.773 * cb), 0.0, 1.0), 1.0));
}
