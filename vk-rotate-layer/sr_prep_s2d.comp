#version 450
// sr_prep_s2d: as sr_prep.comp, but for the space-to-depth models (input NHWC int8, 4 channels on the half grid:
// channel dy*2+dx = Y8-128 of the native pixel (2*gx+dx, 2*gy+dy)). One invocation a 2x2 cell; the colour and the
// one-colour flag are written per native pixel, as sr_prep.comp writes them.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) uniform sampler2D app;
layout(std430, set = 0, binding = 1) writeonly buffer Nin { uint v[]; } nin;
layout(set = 0, binding = 2, rgba8) writeonly uniform image2D cbcr;
layout(push_constant) uniform PC { int ox, oy, W, H, S, wstride; } p;

vec3 px(int x, int y) { return texelFetch(app, ivec2(p.ox + x * p.S, p.oy + y * p.S), 0).rgb; }

// as sr_prep.comp's: the next pixel along and the far corner against the block's first
float flat_block(int x, int y)
{
    ivec2 o = ivec2(p.ox + x * p.S, p.oy + y * p.S);
    vec3 c0 = texelFetch(app, o, 0).rgb;
    vec3 d = max(abs(texelFetch(app, o + ivec2(1, 0), 0).rgb - c0),
                 abs(texelFetch(app, o + ivec2(p.S - 1), 0).rgb - c0));
    return any(greaterThan(d, vec3(1.5 / 255.0))) ? 0.0 : 1.0;
}

void main()
{
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (g.x * 2 >= p.W || g.y * 2 >= p.H) return;
    uint word = 0u;
    for (int dy = 0; dy < 2; dy++)
        for (int dx = 0; dx < 2; dx++) {
            int x = g.x * 2 + dx, y = g.y * 2 + dy;
            vec3 rgb = px(x, y);
            float yl = dot(rgb, vec3(0.299, 0.587, 0.114));
            int q = int(round(clamp(yl, 0.0, 1.0) * 255.0)) - 128;
            word |= (uint(q) & 0xFFu) << (8 * (dy * 2 + dx));
            imageStore(cbcr, ivec2(x, y), vec4((rgb.r - yl) * 0.713 + 0.5, (rgb.b - yl) * 0.564 + 0.5, flat_block(x, y), 1.0));
        }
    nin.v[g.y * p.wstride + g.x] = word;
}
