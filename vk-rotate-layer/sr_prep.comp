#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
// sr_prep: the program's picture (landscape, enlarged by an integer, nearest, the S*W x S*H area at ox,oy)
// -> the NPU's input for ESPCN row5 (NC1HWC2, C2=16: 16 bytes a pixel; channels 0..4 = Y8-128 shifted
//    vertically by dy = c-2, -128 past the edge) + the colour (Cr, Cb + 0.5) of the source pixel in rgba8,
//    and in its blue whether the block is one colour (1.0) or not (0.0, see flat_block).
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) uniform sampler2D app;
layout(std430, set = 0, binding = 1) writeonly buffer Nin { uvec4 v[]; } nin;
layout(set = 0, binding = 2, rgba8) writeonly uniform image2D cbcr;
// how many blocks were not one colour (sr_rotate.frag shows the program's picture as it is above a limit)
layout(std430, set = 0, binding = 3) buffer Cnt { uint n; } cnt;
layout(push_constant) uniform PC { int ox, oy, W, H, S, wstride; } p;

vec3 px(int x, int y) { return texelFetch(app, ivec2(p.ox + x * p.S, p.oy + y * p.S), 0).rgb; }

int q8(int x, int y)
{
    if (y < 0 || y >= p.H) return -128;
    return int(round(clamp(dot(px(x, y), vec3(0.299, 0.587, 0.114)), 0.0, 1.0) * 255.0)) - 128;
}

// The emulator's frame enlarged nearest makes every S*S block one colour. What the program draws over
// it at the full resolution - RetroArch's menu and notifications, PPSSPP's pause screen - does not:
// sr_rotate.frag shows such a block as it is rather than enlarge every S-th pixel of it. One pixel is
// compared with the block's first, (S-1, S-2) (with a step of 2 the far corner too): all S*S of them cost
// the 3DS a sixth of its upscales (Mali 85% instead of 70%). Each block not one colour is counted, and
// npusr.inc.c picks the rotate pass from the count.
float flat_block(int x, int y)
{
    ivec2 o = ivec2(p.ox + x * p.S, p.oy + y * p.S);
    vec3 c0 = texelFetch(app, o, 0).rgb;
    // (S-1, S-2): odd, against the first, so a one-pixel dither shows, and by the far corner; a step of 2 (the PSP)
    // also takes the far corner itself, else a horizontal stroke through the block would pass
    vec3 d = abs(texelFetch(app, o + ivec2(p.S - 1, max(p.S - 2, 0)), 0).rgb - c0);
    if (p.S < 3) d = max(d, abs(texelFetch(app, o + ivec2(p.S - 1), 0).rgb - c0));
    return any(greaterThan(d, vec3(1.5 / 255.0))) ? 0.0 : 1.0;
}

void main()
{
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= p.W || q.y >= p.H) return;
    uint w0 = 0u;
    for (int c = 0; c < 4; c++)
        w0 |= (uint(q8(q.x, q.y + c - 2)) & 0xFFu) << (8 * c);
    uint w1 = uint(q8(q.x, q.y + 2)) & 0xFFu;
    nin.v[q.y * p.wstride + q.x] = uvec4(w0, w1, 0u, 0u);
    vec3 rgb = px(q.x, q.y);
    float yl = dot(rgb, vec3(0.299, 0.587, 0.114));
    float f = flat_block(q.x, q.y);
    uint nf = subgroupAdd(f < 0.5 ? 1u : 0u);   // one atomic a subgroup, not one a block
    if (subgroupElect() && nf > 0u) atomicAdd(cnt.n, nf);
    imageStore(cbcr, q, vec4((rgb.r - yl) * 0.713 + 0.5, (rgb.b - yl) * 0.564 + 0.5, f, 1.0));
}
