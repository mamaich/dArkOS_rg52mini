#version 450
// sr_prep: the program's picture (landscape, enlarged by an integer, nearest, the S*W x S*H area at ox,oy)
// -> the NPU's input for ESPCN row5 (NC1HWC2, C2=16: 16 bytes a pixel; channels 0..4 = Y8-128 shifted
//    vertically by dy = c-2, -128 past the edge) + the colour (Cr, Cb + 0.5) of the source pixel in rgba8,
//    and in its blue whether the block is one colour (1.0) or not (0.0, see flat_block).
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) uniform sampler2D app;
layout(std430, set = 0, binding = 1) writeonly buffer Nin { uvec4 v[]; } nin;
layout(set = 0, binding = 2, rgba8) writeonly uniform image2D cbcr;
layout(push_constant) uniform PC { int ox, oy, W, H, S, wstride; } p;

vec3 px(int x, int y) { return texelFetch(app, ivec2(p.ox + x * p.S, p.oy + y * p.S), 0).rgb; }

int q8(int x, int y)
{
    if (y < 0 || y >= p.H) return -128;
    return int(round(clamp(dot(px(x, y), vec3(0.299, 0.587, 0.114)), 0.0, 1.0) * 255.0)) - 128;
}

// The emulator's frame enlarged nearest makes every S*S block one colour. What the program draws over
// it at the full resolution - RetroArch's menu and notifications, PPSSPP's pause screen - does not:
// sr_rotate.frag shows such a block as it is rather than enlarge every S-th pixel of it.
float flat_block(int x, int y)
{
    vec3 c0 = px(x, y);
    for (int dy = 0; dy < p.S; dy++)
        for (int dx = 0; dx < p.S; dx++) {
            vec3 c = texelFetch(app, ivec2(p.ox + x * p.S + dx, p.oy + y * p.S + dy), 0).rgb;
            if (any(greaterThan(abs(c - c0), vec3(1.5 / 255.0))))
                return 0.0;
        }
    return 1.0;
}

void main()
{
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= p.W || q.y >= p.H) return;
    uint w0 = 0u;
    for (int c = 0; c < 4; c++)
        w0 |= (uint(q8(q.x, q.y + c - 2)) & 0xFFu) << (8 * c);
    uint w1 = uint(q8(q.x, q.y + 2)) & 0xFFu;
    nin.v[q.y * p.wstride + q.x] = uvec4(w0, w1, 0u, 0u);
    vec3 rgb = px(q.x, q.y);
    float yl = dot(rgb, vec3(0.299, 0.587, 0.114));
    imageStore(cbcr, q, vec4((rgb.r - yl) * 0.713 + 0.5, (rgb.b - yl) * 0.564 + 0.5, flat_block(q.x, q.y), 1.0));
}
