[Unit]
Description=Show custom boot welcome message
DefaultDependencies=no
After=local-fs.target firstboot.service
# ES no longer waits the 2.2 s of the message (christianhaitian/dArkOS e752dfdb, 2026-10-31);
# ES orders itself after firstboot.service on its own.
#Before=emulationstation.service
Conflicts=shutdown.target
#ConditionKernelCommandLine=!quiet

[Service]
Type=oneshot
ExecStart=/usr/local/bin/boot_text.sh
StandardOutput=tty
StandardInput=tty
TTYPath=/dev/tty1
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target