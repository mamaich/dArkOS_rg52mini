def shared_card():
    # A card shared with GammaOS: /roms is the ROMs folder of Android's internal storage
    try:
        for line in open("/proc/self/mountinfo"):
            f = line.split()
            if f[4] == "/roms":
                return f[3].endswith("/ROMs")
    except (OSError, IndexError):
        pass
    return False


