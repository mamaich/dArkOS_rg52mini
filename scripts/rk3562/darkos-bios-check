# ---------------------------------------------------------------- PS2 (ARMSX2)

def ps2_bios_ok(root):
    """As ARMSX2 (pcsx2/ps2/BiosTools.cpp): the BIOS named in PCSX2.ini when it exists, else
    any file of 4 to 8 MiB in the BIOS folder whose ROMDIR has RESET and ROMVER, whatever its name."""
    bios, name = "/%s/bios" % root, ""
    section = ""
    try:
        for line in open("/%s/ps2/pcsx2/inis/PCSX2.ini" % root, errors="replace"):
            line = line.strip()
            if line.startswith("["):
                section = line
            elif "=" in line:
                k, v = (x.strip() for x in line.split("=", 1))
                if section == "[Folders]" and k == "Bios" and v:
                    bios = v
                elif section == "[Filenames]" and k == "BIOS":
                    name = v
    except OSError:
        pass
    if name and os.path.isfile(os.path.join(bios, name)):
        return True, bios
    try:
        files = os.listdir(bios)
    except OSError:
        return False, bios
    for f in files:
        p = os.path.join(bios, f)
        try:
            if os.path.isfile(p) and 4 << 20 <= os.path.getsize(p) <= 8 << 20 and ps2_romdir(p):
                return True, bios
        except OSError:
            pass
    return False, bios


def ps2_romdir(path):
    # The ROMDIR, 16-byte entries (name[10], extinfo size, file size) from a "RESET" one on,
    # sits near the start of every PS2 BIOS (0x2700); ARMSX2 reads the whole file for it.
    with open(path, "rb") as f:
        data = f.read(0x40000)
    i = data.find(b"RESET\0")
    while i >= 0 and i % 16:
        i = data.find(b"RESET\0", i + 1)
    if i < 0:
        return False
    for o in range(i, len(data) - 15, 16):
        n = data[o:o + 10].split(b"\0")[0]
        if not n:
            break
        if n == b"ROMVER":
            return True
    return False


# ---------------------------------------------------------------- the check

def ra_system_dir(emulator, romdir):
    # RetroArch's system_directory; "default" (or none) is the game's own folder
    v = None
    try:
        for line in open(ra_dir(emulator, "retroarch.cfg") + "/retroarch.cfg", errors="replace"):
            k, eq, val = line.partition("=")
            if eq and k.strip() == "system_directory":
                v = val.strip().strip('"')
    except OSError:
        pass
    if not v or v == "default":
        return romdir
    if v.startswith("~"):
        v = "/home/ark" + v[1:]
    return v


def missing(front, core, rom, core_path=None):
    """(the BIOS folder, [(need, (found, wanted) or None)]) for what the game lacks; the pair
    is a file whose name differs from a wanted one only in upper/lower case."""
    g = Game(front, core, rom, core_path)
    if front == "pcsx2":
        ok, bios = ps2_bios_ok(g.root)
        return bios, [] if ok else [(need("a PS2 BIOS: the dump of a PS2 console's, any name, 4 MB",
                                          "BIOS PS2: дамп BIOS консоли PS2, с любым именем, 4 МБ",
                                          "SCPH-xxxxx.bin"), None)]
    if front in ("retroarch", "retroarch32", "retroarch-next"):
        bios = ra_system_dir(front, g.romdir)
    else:
        bios = "/%s/bios" % g.root      # retrorun's -d, Mednafen's firmware, flycast's data folder
    out = []
    for r in RULES:
        if r["front"] is not None and front not in r["front"]:
            continue
        if r["cores"] is not None and core not in r["cores"]:
            continue
        if r["dirs"] is not None and g.sysdir not in r["dirs"]:
            continue
        if r["exts"] is not None and not g.exts() & r["exts"]:
            continue
        if r["when"] is not None and not r["when"](g):
            continue
        for n in (r["needs"](g, bios) if callable(r["needs"]) else r["needs"]):
            paths = [os.path.join(g.romdir, a[5:]) if a.startswith("@rom/") else os.path.join(bios, a)
                     for a in n["alts"]]
            if any(os.path.exists(p) for p in paths):
                continue
            out.append((n, twin(paths)))
    return bios, out


def twin(paths):
    # A file that differs from a wanted name only in upper/lower case: exFAT finds it, ext4 (the
    # ROMs folder of a card shared with GammaOS) does not, so it is worth saying.
    for p in paths:
        d, n = os.path.split(p)
        try:
            for f in os.listdir(d):
                if f.lower() == n.lower() and f != n:
                    return os.path.join(d, f), p
        except OSError:
            pass
    return None


