def bluemsx_needs(g, bios):
    """The machine blueMSX starts (its option, or by the game's extension): its folder from the
    core's system pack and the ROMs its config.ini lists. The image's build has no C-BIOS
    fallback: without them it stays on a black screen, or does not load at all."""
    import re
    v = g.option("bluemsx_msxtype", "Auto")
    if v == "Auto":
        e = (g.exts() - {"zip"}) or {g.ext}
        machine = ("MSX2+" if e & {"rom", "mx1", "mx2", "dsk", "m3u", "cas"} else
                   "COL - ColecoVision" if "col" in e else "SEGA - SG-1000" if "sg" in e else
                   "SEGA - SF-7000" if "sf" in e else "SEGA - SC-3000")
    else:
        machine = {"ColecoVision": "COL - ColecoVision",
                   "Coleco (Spectravideo SVI-603)": "COL - Spectravideo SVI-603 Coleco"}.get(v, v)
    what = ("blueMSX's %s machine, from the core's system pack (the Machines folder)" % machine,
            "машина %s для blueMSX, из системного пакета ядра (папка Machines)" % machine)
    if os.path.exists(os.path.join(bios, "Machines", machine + ".zip")):
        return []
    try:
        with open(os.path.join(bios, "Machines", machine, "config.ini"), errors="replace") as f:
            roms = sorted(set(re.findall(r'"(Machines/[^"]+)"', f.read())))
    except OSError:
        return [need(*what, "Machines/%s/config.ini" % machine)]
    return [need(*what, r) for r in roms]


