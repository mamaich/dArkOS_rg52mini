def t(key):
    return T[key][1 if lang() == "ru" else 0]


def height(text, extra):
    import textwrap
    n = sum(max(1, len(textwrap.wrap(line, W - 6))) for line in text.split("\n"))
    return min(n + extra, 30)


def run_quiet(*cmd):
    import subprocess
    subprocess.run(list(cmd), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def screen(title, text, yes=None, no=None):
    """A dialog box on the console (tty1), the pad turned into keys by gptokeyb. True for the
    yes (or OK) button. None when no box could be shown: the caller starts the game then."""
    import subprocess
    import time
    tty = "/dev/tty1"
    env = dict(os.environ, TERM="linux", LC_ALL="C.UTF-8", DIALOGRC="/opt/inttools/noshadows.dialogrc")
    run_quiet("sudo", "chmod", "666", tty, "/dev/uinput")
    # a port stopped before its end leaves the console unbound: the box would be drawn on nothing
    try:
        with open("/sys/class/vtconsole/vtcon1/bind") as f:
            if f.read().strip() == "0":
                run_quiet("sudo", "sh", "-c", "echo 1 > /sys/class/vtconsole/vtcon1/bind")
    except OSError:
        pass
    run_quiet("sudo", "setfont", "/usr/share/consolefonts/Uni2-TerminusBold22x11.psf.gz")
    pad = None
    try:
        with open(tty, "w") as f:
            f.write("\033c\033%G\033[?25l")   # cleared, UTF-8 for the Russian text, no cursor
        if subprocess.run(["pgrep", "-f", "gptokeyb"], stdout=subprocess.DEVNULL).returncode != 0:
            pad = subprocess.Popen(["/opt/inttools/gptokeyb", "-1", "dialog", "-c", "/opt/inttools/keys.gptk"],
                                   env=dict(env, SDL_GAMECONTROLLERCONFIG_FILE="/opt/inttools/gamecontrollerdb.txt"),
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        cmd = ["dialog", "--backtitle", t("back"), "--title", title, "--no-collapse"]
        if yes:
            cmd += ["--yes-label", yes, "--no-label", no, "--yesno", text, str(height(text, 6)), str(W)]
        else:
            cmd += ["--ok-label", "OK", "--msgbox", text, str(height(text, 6)), str(W)]
        start = time.monotonic()
        with open(tty, "r") as i, open(tty, "w") as o:
            rc = subprocess.run(cmd, stdin=i, stdout=o, env=env).returncode
        if rc not in (0, 1) and time.monotonic() - start < 1:
            return None     # dialog could not run at all
        return rc == 0
    except OSError:
        return None
    finally:
        if pad:
            pad.kill()
            pad.wait()
        try:
            with open(tty, "w") as f:
                f.write("\033c")
        except OSError:
            pass
        run_quiet("sudo", "setfont", "/usr/share/consolefonts/Lat7-Terminus20x10.psf.gz")


def report(front, core, rom, bios, lacks):
    lines = []
    ru = lang() == "ru"
    for n, tw in lacks[:8]:
        lines.append("  - " + n["show"])
        lines.append("    " + n["ru" if ru else "en"])
        if tw:
            lines.append("    " + t("found") % (os.path.basename(tw[0]), os.path.basename(tw[1])))
    if len(lacks) > 8:
        lines.append("  ... +%d" % (len(lacks) - 8))
    who = core if core and core != "-" else {"pcsx2": "ARMSX2", "mednafen": "Mednafen", "flycast": "Flycast"}.get(front, front)
    text = "\n".join([t("head") % (os.path.basename(rom), who, bios), ""] + lines +
                     ["", t("where2") if shared_card() else t("where"), "", t("off")])
    return screen(t("title"), text, t("goback"), t("anyway"))


def check(front, core, rom, core_path=None):
    """0: start the game; 1: do not."""
    if not enabled() or not rom or not os.path.exists(rom):
        return 0
    try:
        bios, lacks = missing(front, core, rom, core_path)
    except Exception:
        return 0
    if not lacks:
        return 0
    return 1 if report(front, core, rom, bios, lacks) else 0


def ra_args(args):
    # (core, its path, game) from RetroArch's arguments as ES gives them: -L <core>_libretro.so <game>
    path = rom = None
    for i, a in enumerate(args):
        if a in ("-L", "--libretro") and i + 1 < len(args):
            path = args[i + 1]
        elif a.startswith("--libretro="):
            path = a.split("=", 1)[1]
    if path and args and not args[-1].startswith("-") and args[-1] != path:
        rom = args[-1]
    core = None
    if path:
        core = os.path.basename(path)
        core = core[:-len("_libretro.so")] if core.endswith("_libretro.so") else os.path.splitext(core)[0]
    return core, path, rom


def failed(front, log, args):
    import re
    core, _, rom = ra_args(args)
    try:
        with open(log, errors="replace") as f:
            text = f.read()
    except OSError:
        return
    text = re.sub(r"\x1b\[[0-9;]*m", "", text)
    lines, seen = [], set()
    for line in text.splitlines():
        line = line.strip()
        if "ERROR]" in line and line not in seen:
            seen.add(line)
            lines.append(line)
    if not lines:
        lines = [x.strip() for x in text.splitlines() if x.strip()][-5:]
    msg = "\n".join([t("fhead") % (os.path.basename(rom or "?"), core or front), ""] + lines[-8:] +
                    ["", t("fwhy"), "", t("foff")])
    screen(t("ftitle"), msg)


def enabled():
    return not os.path.exists(FLAG)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "enabled":
        return 0 if enabled() else 1
    if cmd == "ra" and len(argv) >= 3:
        core, path, rom = ra_args(argv[3:])
        return check(argv[2], core, rom, path) if core and rom else 0
    if cmd == "run" and len(argv) >= 5:
        return check(argv[2], argv[3], argv[4])
    if cmd == "failed" and len(argv) >= 4:
        if enabled():
            failed(argv[2], argv[3], argv[4:])
        return 0
    if cmd == "missing" and len(argv) >= 5:
        bios, lacks = missing(argv[2], argv[3], argv[4])
        for n, tw in lacks:
            print("%s\t%s\t%s%s" % (bios, n["show"], n["en"], "\t(there is %s)" % tw[0] if tw else ""))
        return 1 if lacks else 0
    sys.exit("darkos-bios-check: ra|run|failed|missing|enabled, see the head of this file")


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except SystemExit:
        raise
    except BaseException:
        sys.exit(0)     # a failure here must not keep the game from starting
