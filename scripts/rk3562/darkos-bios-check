#!/usr/bin/python3 -IS
# darkos-bios-check (dArkOS, RG52 Mini): before a game starts, the BIOS files its emulator
# cannot start it without, said on the screen with the folder they go to. Without them most
# emulators quit at once and leave the player back in EmulationStation with no word of why
# (docs/KNOWN-ISSUES.md, "BIOS check before a game starts").
#
#   darkos-bios-check ra <emulator> <RetroArch's arguments>
#       the retroarch, retroarch32 and retroarch-next wrappers, before RetroArch starts
#   darkos-bios-check run <emulator> <core or -> <game>
#       other launchers: pcsx2 (ARMSX2), mednafen, flycast (standalone), retrorun, retrorun32
#   darkos-bios-check failed <emulator> <log> <RetroArch's arguments>
#       RetroArch quit at once with status 1: the errors from the log of its second start
#   darkos-bios-check missing <emulator> <core or -> <game>
#       what is missing, printed: no screen, no switch (for tests)
#   darkos-bios-check enabled
#       status 0 unless Options > Advanced > Disable BIOS Check turned the check off
#
# ra and run exit 1 when the game must not start (the player chose Back), else 0. Anything
# that goes wrong here starts the game: the check must never be the reason a game does not run.
#
# The rules ask only for what makes a game fail to load, as the cores' sources have it (read
# 2026-11-09). Files a core can do without (an HLE or built-in BIOS, a better but optional
# one) are not asked for. Where the right file depends on the disc (its region) or on a core
# option, any one of them passes; RetroArch's own error, shown after a failed start ("failed"
# above), then names the one it wanted.

# The check runs before every game: python3 -IS (no site: 48 ms to start on the RG52 Mini
# against 70), only os and sys at the start (re and subprocess load when a box is shown), and
# zips read by zip_dir below (zipfile took 80 ms to import). About 0.1 s a game in all.
import os
import sys

FLAG = "/home/ark/.config/.NOBIOSCHECK"
W = 76                      # the box's width, as the DDR tool's (Terminus 22x11 on the 1280 px console)
LIBRETRO = {"retroarch", "retroarch32", "retroarch-next", "retrorun", "retrorun32"}


def need(en, ru, *alts, show=None):
    """A file the game needs: any one of alts is enough. A path is under the BIOS folder, or
    under the game's own folder when it starts with @rom/. en and ru say what it is; show is
    how the names are written on the screen (alts[0] when there is one)."""
    return {"alts": alts, "en": en, "ru": ru, "show": show or alts[0]}


def rule(front, needs, cores=None, dirs=None, exts=None, when=None):
    """needs (a list, or a function of the game and the BIOS folder giving one) apply when the emulator is in
    front, the core in cores, the game's system folder (/roms/<dir>/...) in dirs, its
    extension (or that of a file in its zip) in exts and when(game) is true. None matches
    anything."""
    return {"front": front, "cores": cores, "dirs": dirs, "exts": exts, "when": when, "needs": needs}


class Game:
    """The game being started: its path and folders, extension, zip entries and first bytes,
    and the emulator and core it starts with."""

    def __init__(self, front, core, rom, core_path=None):
        self.front, self.core, self.rom = front, core, rom
        path = os.path.abspath(rom)
        parts = path.split("/")
        under = len(parts) > 3 and parts[1].startswith("roms")
        self.root = parts[1] if under else "roms"       # the ROMs partition: roms, or roms2
        self.sysdir = parts[2] if under else ""         # the system's folder: segacd in /roms/segacd/x/y.cue
        self.romdir = os.path.dirname(path)
        self.ext = os.path.splitext(rom)[1][1:].lower()
        self.core_path = core_path or "/home/ark/.config/%s/cores/%s_libretro.so" % (
            "retroarch32" if front in ("retroarch32", "retrorun32") else "retroarch", core)
        self._zip = False          # not read yet

    def zip_entries(self):
        """[(name, crc)] of a zipped game, [] for any other game, None for a zip that could not
        be read."""
        if self._zip is False:
            self._zip = zip_dir(self.rom) if self.ext == "zip" else []
        return None if self._zip is None else [(e[0], e[1]) for e in self._zip]

    def exts(self):
        return {self.ext} | {os.path.splitext(n)[1][1:].lower() for n, _ in self.zip_entries() or ()}

    def head(self, n):
        try:
            with open(self.rom, "rb") as f:
                return f.read(n)
        except OSError:
            return b""

    def data_head(self, n):
        """The first bytes of the game: of a zip's first file, as RetroArch hands it to a core
        that does not open zips itself."""
        if self.ext != "zip":
            return self.head(n)
        self.zip_entries()
        files = [e for e in self._zip or () if not e[0].endswith("/")]
        return zip_head(self.rom, files[0], n) if files else b""

    def option(self, key, default):
        """A core option's value as RetroArch gives it to the core: the options file, then the
        core's own file, its folder's and its game's (game-specific options); the last one found."""
        ra = ra_dir(self.front, "retroarch-core-options.cfg")
        files = [ra + "/retroarch-core-options.cfg"]
        name = None
        try:
            for line in open(os.path.splitext(self.core_path)[0] + ".info", errors="replace"):
                k, eq, v = line.partition("=")
                if eq and k.strip() == "corename":
                    name = v.strip().strip('"')
        except OSError:
            pass
        if name:
            files += ["%s/config/%s/%s.opt" % (ra, name, x) for x in
                      (name, os.path.basename(self.romdir), os.path.splitext(os.path.basename(self.rom))[0])]
        value = default
        for f in files:
            try:
                for line in open(f, errors="replace"):
                    k, eq, v = line.partition("=")
                    if eq and k.strip() == key:
                        value = v.strip().strip('"')
            except OSError:
                pass
        return value


def zip_dir(path):
    """[(name, crc, method, compressed size, local header offset)] from a zip's central
    directory; None when it cannot be read."""
    import struct
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            tail = min(size, 65557)     # the end record and a comment of up to 64 KiB
            f.seek(size - tail)
            data = f.read(tail)
            i = data.rfind(b"PK\x05\x06")
            if i < 0:
                return None
            cd_size, cd_off = struct.unpack_from("<II", data, i + 12)
            f.seek(cd_off)
            cd = f.read(cd_size)
        out, p = [], 0
        while p + 46 <= len(cd) and cd[p:p + 4] == b"PK\x01\x02":
            flags, method = struct.unpack_from("<HH", cd, p + 8)
            crc, csize, _, nlen, xlen, clen = struct.unpack_from("<IIIHHH", cd, p + 16)
            off = struct.unpack_from("<I", cd, p + 42)[0]
            name = cd[p + 46:p + 46 + nlen].decode("utf-8" if flags & 0x800 else "cp437", "replace")
            out.append((name, crc, method, csize, off))
            p += 46 + nlen + xlen + clen
        return out
    except (OSError, ValueError, struct.error):
        return None


def zip_head(path, entry, n):
    # the first n bytes of a stored or deflated file in a zip
    import struct
    import zlib
    _, _, method, csize, off = entry
    try:
        with open(path, "rb") as f:
            f.seek(off)
            h = f.read(30)
            if h[:4] != b"PK\x03\x04":
                return b""
            nlen, xlen = struct.unpack_from("<HH", h, 26)
            f.seek(off + 30 + nlen + xlen)
            data = f.read(min(csize, 65536))
        if method == 0:
            return data[:n]
        if method == 8:
            return zlib.decompressobj(-15).decompress(data, n)
    except (OSError, ValueError, struct.error, zlib.error):
        pass
    return b""


def ra_dir(front, name):
    # RetroArch's folder for front; retroarch-next's has its files after its first start only,
    # and they are copies of the release's
    d = "/home/ark/.config/" + ("retroarch32" if front in ("retroarch32", "retrorun32") else
                                "retroarch-next" if front == "retroarch-next" else "retroarch")
    if front == "retroarch-next" and not os.path.exists(os.path.join(d, name)):
        d = "/home/ark/.config/retroarch"
    return d


# ---------------------------------------------------------------- conditions

def sega_cd(g):
    """A Sega CD disc as Genesis Plus GX and PicoDrive tell one: a cue or chd (an m3u lists
    them), or an image that starts with SEGADISCSYSTEM (cooked, or raw after 16 bytes)."""
    if g.ext in ("cue", "chd", "m3u"):
        return True
    h = g.head(32)
    return h.startswith(b"SEGADISCSYSTEM") or h[16:30] == b"SEGADISCSYSTEM"


def pico_cd(g):
    # PicoDrive: a disc with a cartridge of its name beside it is an MSU-MD game, no BIOS needed
    if not sega_cd(g):
        return False
    base = os.path.splitext(g.rom)[0]
    return not any(os.path.exists(base + e) for e in (".gen", ".smd", ".md", ".32x"))


def fds(g):
    return g.sysdir == "fds" or "fds" in g.exts()


def zip_lacks(crcs=(), prefixes=()):
    """A game that does not carry these BIOS ROMs in its own zip (by CRC, or a name's start):
    FBNeo and flycast look there too. A 7z is not looked into, so not checked either."""
    def f(g):
        if g.ext == "7z":
            return False
        if g.ext != "zip":
            return True
        entries = g.zip_entries()
        if entries is None:
            return False
        have = {c for _, c in entries}
        names = [n.lower().rsplit("/", 1)[-1] for n, _ in entries]
        if crcs and all(c in have for c in crcs):
            return False
        if prefixes and any(n.startswith(prefixes) for n in names):
            return False
        return True
    return f


def core_has(marker, has=True):
    # marker is (or, has=False, is not) in the core's file: builds before and after a core got a
    # built-in BIOS tell apart by a message of theirs. A core that cannot be read is not checked.
    def f(g):
        try:
            with open(g.core_path, "rb") as fh:
                return (marker in fh.read()) == has
        except OSError:
            return False
    return f


def core_lacks(marker):
    return core_has(marker, False)


def lynx_cart(g):
    # a cartridge (a LYNX header, or raw), not homebrew in BS93 form, which starts without the
    # boot ROM: only the boot ROM decrypts and loads a cartridge. A file not read is not checked.
    h = g.data_head(10)
    return len(h) == 10 and h[6:10] != b"BS93"


def sufami_cart(g):
    # a Sufami Turbo cartridge, as snes9x tells one (and not the BIOS itself)
    h = g.data_head(32)
    return h[:14] == b"BANDAI SFC-ADX" and h[16:30] != b"SFC-ADX BACKUP"


def pce_cd_needs(g, bios):
    # the System Card the core option names; Beetle PCE (not fast) is not read: any one passes
    cards = {"System Card 3": "syscard3.pce", "System Card 2": "syscard2.pce", "System Card 1": "syscard1.pce",
             "Games Express": "gexpress.pce", "System Card 3 US": "syscard3u.pce", "System Card 2 US": "syscard2u.pce"}
    key = {"mednafen_pce_fast": "pce_fast_cdbios", "mednafen_supergrafx": "sgx_cdbios"}.get(g.core)
    card = cards.get(g.option(key, "System Card 3")) if key else None
    what = ("PC Engine CD System Card, as the core options name it",
            "System Card для PC Engine CD, как выбрано в настройках ядра")
    if card:
        return [need(*what, card)]
    return [need(*what, *cards.values(), show="syscard3.pce")]


def ps1_needs(g, bios):
    # SwanStation before its built-in OpenBIOS and the old DuckStation find a PS1 BIOS by its
    # size (and MD5), under any name
    try:
        for f in os.listdir(bios):
            if os.path.getsize(os.path.join(bios, f)) in (524288, 4194304, 4089584):
                return []
    except OSError:
        pass
    return [need("a PS1 BIOS: any name, 512 KB, such as scph5501.bin (USA), scph5502.bin (Europe), "
                 "scph5500.bin (Japan)",
                 "BIOS PS1: с любым именем, 512 КБ, например scph5501.bin (США), scph5502.bin (Европа), "
                 "scph5500.bin (Япония)", "scph5501.bin", show="scph5501.bin / scph5502.bin / scph5500.bin")]


