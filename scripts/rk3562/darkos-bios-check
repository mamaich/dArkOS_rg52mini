def amiga_cd_needs(g, bios):
    """A CD32 or CDTV disc in PUAE or UAE4ARM: the real Kickstart and its extension ROM. Both
    cores fall back to AROS without a Kickstart, which starts floppies and hard disks but not
    these. Only with the cores' default model options: a model or Kickstart of the player's
    own choice is left alone."""
    cdtv = "cdtv" in g.rom.lower()
    if g.core == "uae4arm":
        if g.option("uae4arm_model", "Auto") != "Auto" or g.ext not in ("cue", "ccd", "iso"):
            return []
        main, ext = (("kick34005.A500",), ("kick34005.CDTV",)) if cdtv else (("kick40060.CD32",), ("kick40060.CD32.ext",))
    else:
        if g.option("puae_kickstart", "auto") != "auto":
            return []
        model = g.option("puae_model", "auto")
        if model == "auto":
            model = "CDTV" if cdtv else g.option("puae_model_cd", "CD32")
        if model.startswith("CD32"):
            main, ext = PUAE_CD32, PUAE_CD32_EXT
        elif model == "CDTV":
            main, ext = PUAE_KS13, PUAE_CDTV_EXT
        else:
            return []
    name = "CDTV" if main[0] == "kick34005.A500" else "CD32"
    out = [need("Amiga %s Kickstart" % name, "Kickstart Amiga %s" % name, *main)]
    # a 1 MiB CD32 Kickstart carries its extension already
    if not any(os.path.isfile(os.path.join(bios, m)) and os.path.getsize(os.path.join(bios, m)) > 524288
               for m in main):
        out.append(need("Amiga %s extension ROM" % name, "ROM расширения Amiga %s" % name, *ext))
    return out


