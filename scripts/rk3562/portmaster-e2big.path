[Unit]
Description=PortMaster: re-add the E2BIG guard and the rest after PortMaster installs or updates

[Path]
PathChanged=/opt/system/Tools/PortMaster/mod_dArkOS.txt
PathChanged=/roms/ports/PortMaster/mod_dArkOS.txt
PathChanged=/roms2/ports/PortMaster/mod_dArkOS.txt
PathChanged=/roms/tools/PortMaster/mod_dArkOS.txt
# control.txt (get_controls): the same, an update replaces it
PathChanged=/opt/system/Tools/PortMaster/control.txt
PathChanged=/roms/ports/PortMaster/control.txt
PathChanged=/roms2/ports/PortMaster/control.txt
PathChanged=/roms/tools/PortMaster/control.txt
Unit=portmaster-e2big.service

[Install]
WantedBy=multi-user.target
