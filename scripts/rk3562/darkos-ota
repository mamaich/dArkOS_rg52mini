#!/usr/bin/python3
# darkos-ota: over-the-air updates for dArkOS on the RG52 Mini.
#
# A package carries the files that differ between two builds of the image -
# the root filesystem (p4, btrfs) and the boot partition (p3, vfat) - and, if
# it changed, the boot loader. It applies to exactly one build: the one its
# manifest names in from_build_id, compared against BUILD_ID in
# /etc/darkos-release. Each file carries the sha256 it had in the old build and
# in the new one, so that what the user changed is not overwritten.
#
# On a dual-boot card (/boot/dualboot) the boot loader and everything of
# GammaOS belong to GammaOS: the loader is never written, and the files the
# dual-boot builder puts on p3 are never replaced or deleted.
#
# Before the root filesystem is touched a read-only btrfs snapshot of it is
# taken, and the boot files about to change are copied aside; a failure while
# applying puts everything back, and "rollback" does the same after a reboot,
# merging the package databases rather than putting them back (what was
# installed or removed with apt since the update stays as it is).
#
# docs/OTA.md describes the format and the release procedure.

import argparse
import fnmatch
import hashlib
import json
import os
import shutil
import stat
import subprocess
import sys
import tarfile
import time
import urllib.request

RELEASE_FILE = "/etc/darkos-release"
CONF_FILE = "/etc/darkos-ota.conf"
FEED_OVERRIDE = "/home/ark/.config/darkos-ota-feed"
STATE_DIR = "/var/lib/darkos-ota"
WORK_DIR = "/var/cache/darkos-ota"
LOG_FILE = STATE_DIR + "/ota.log"
MERGED_LIST = STATE_DIR + "/merged"
# The package databases. An update keeps them as it left them (AFTER_DIR), and a
# rollback merges them with the old build's instead of putting those back
# (rollback_packages).
DPKG_DBS = [("var/lib/dpkg/status", "stanzas"), ("var/lib/apt/extended_states", "stanzas"),
            ("var/lib/dpkg/triggers/File", "lines")]
DPKG_INFO = "var/lib/dpkg/info"
AFTER_DIR = STATE_DIR + "/after"
LOCAL_DIRS = ["/roms/update", "/roms/tools/update"]
SNAP_PREFIX = "/.ota-snapshot-"
DEFAULT_FEED = ("https://raw.githubusercontent.com/mamaich/dArkOS_rg52mini/"
                "master/ota/rg52mini.json")
FORMAT = 1

# p3 files that belong to the dual-boot builder (and the boot loader's menu):
# never replaced, never deleted.
BOOT_PROTECTED = ["dualboot", "bootmenu_*.bmp", "bootmenu2_*.bmp"]
# Paths a user is expected to edit: a file there that differs from both the
# old and the new build is kept, and the new one is put beside it.
USER_PREFIXES = ["etc/", "home/", "root/", "var/lib/"]


class OtaError(Exception):
    pass


def log(msg):
    line = time.strftime("%Y-%m-%d %H:%M:%S ") + msg
    print(msg, flush=True)
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(LOG_FILE, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def read_kv(path):
    d = {}
    try:
        with open(path) as f:
            for ln in f:
                ln = ln.strip()
                if "=" in ln and not ln.startswith("#"):
                    k, v = ln.split("=", 1)
                    d[k.strip()] = v.strip().strip('"')
    except OSError:
        pass
    return d


def release():
    r = read_kv(RELEASE_FILE)
    if "BUILD_ID" not in r:
        raise OtaError("%s has no BUILD_ID: this build predates OTA updates "
                       "(1.1); write the image of a newer release to the card"
                       % RELEASE_FILE)
    return r


def sha256_file(path, bufsize=1 << 20):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            b = f.read(bufsize)
            if not b:
                break
            h.update(b)
    return h.hexdigest()


def current_hash(path):
    """sha256 of a regular file, "link:<target>" of a symlink, "dir" of a
    directory, None if absent."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(st.st_mode):
        return "link:" + os.readlink(path)
    if stat.S_ISDIR(st.st_mode):
        return "dir"
    if stat.S_ISREG(st.st_mode):
        return sha256_file(path)
    return "other"


def is_dualboot():
    return os.path.exists("/boot/dualboot")


def root_disk():
    src = subprocess.run(["findmnt", "-n", "-o", "SOURCE", "/"],
                         capture_output=True, text=True).stdout.strip()
    src = src.split("[")[0]
    pk = subprocess.run(["lsblk", "-n", "-o", "PKNAME", src],
                        capture_output=True, text=True).stdout.strip()
    if not pk:
        raise OtaError("cannot find the disk the root filesystem is on")
    return "/dev/" + pk.splitlines()[0]


def uboot_partition():
    """The partition named uboot on the disk dArkOS runs from (the eMMC
    carries one of its own, which must not be touched)."""
    disk = root_disk()
    out = subprocess.run(["lsblk", "-n", "-r", "-o", "NAME,TYPE", disk],
                         capture_output=True, text=True).stdout
    for ln in out.splitlines():
        name, typ = (ln.split() + ["", ""])[:2]
        if typ != "part":
            continue
        # the GPT entry itself, not udev's copy of it
        label = subprocess.run(["blkid", "-p", "-o", "value", "-s",
                                "PART_ENTRY_NAME", "/dev/" + name],
                               capture_output=True, text=True).stdout.strip()
        if label == "uboot":
            return "/dev/" + name
    raise OtaError("no uboot partition on " + disk)


def battery_ok(minimum):
    base = "/sys/class/power_supply"
    try:
        for n in os.listdir(base):
            p = os.path.join(base, n)
            if open(os.path.join(p, "type")).read().strip() != "Battery":
                continue
            cap = int(open(os.path.join(p, "capacity")).read().strip())
            st = open(os.path.join(p, "status")).read().strip()
            return cap >= minimum or st in ("Charging", "Full"), cap
    except (OSError, ValueError):
        pass
    return True, None


def free_bytes(path):
    s = os.statvfs(path)
    return s.f_bavail * s.f_frsize


# ---------------------------------------------------------------- feed

def feed_url(override=None):
    if override:
        return override
    try:
        u = open(FEED_OVERRIDE).read().strip()
        if u:
            return u
    except OSError:
        pass
    return read_kv(CONF_FILE).get("FEED", DEFAULT_FEED)


def fetch(url, timeout=60):
    if url.startswith("/") or url.startswith("file://"):
        return open(url.replace("file://", ""), "rb").read()
    req = urllib.request.Request(url, headers={"User-Agent": "darkos-ota",
                                               "Cache-Control": "no-cache"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def feed_entries(feed=None, timeout=60):
    """The feed's packages for this device."""
    rel = release()
    data = json.loads(fetch(feed_url(feed), timeout).decode())
    return [e for e in data.get("response", [])
            if e.get("device", "rg52mini") == rel.get("DEVICE", "rg52mini")]


def newest_from(entries, build_id):
    """The newest package that updates build_id, or None."""
    cands = [e for e in entries if e.get("from_build_id") == build_id]
    if not cands:
        return None
    return max(cands, key=lambda e: e.get("build_id", ""))


def steps_after(entries, build_id):
    """The versions the feed leads to from build_id, one package at a time,
    the newest each time. From 1.9 on a release brings packages from the two
    releases before it only, so an older build gets there in steps."""
    out, seen = [], {build_id}
    while len(out) < 30:
        e = newest_from(entries, build_id)
        if not e or e.get("build_id") in seen:
            break
        out.append(e.get("version", "?"))
        build_id = e.get("build_id")
        seen.add(build_id)
    return out


def check(feed=None):
    """The newest feed entry that applies to this build, or None. Its "after"
    lists the versions that follow it, one more update each."""
    entries = feed_entries(feed)
    e = newest_from(entries, release()["BUILD_ID"])
    if not e:
        return None
    return dict(e, after=steps_after(entries, e.get("build_id")))


def next_steps(feed=None, build_id=None):
    """What follows an update just applied (with none pending, this build): a
    package for it in the update folders, else the versions the feed leads to.
    The feed gets a short wait; without the network the answer is none."""
    if build_id is None:
        st = load_state()
        build_id = st.get("to_build_id") if st.get("status") == "applied" \
            else release()["BUILD_ID"]
    loc = local_packages(build_id)
    if loc:
        return [max(loc, key=lambda x: x[1].get("build_id", ""))[1].get("version", "?")]
    try:
        return steps_after(feed_entries(feed, timeout=15), build_id)
    except Exception:
        return []


def local_packages(build_id=None):
    """Packages in the update folders for this build (or build_id)."""
    if build_id is None:
        build_id = release()["BUILD_ID"]
    found = []
    for d in LOCAL_DIRS:
        if not os.path.isdir(d):
            continue
        for n in sorted(os.listdir(d)):
            if not n.endswith(".tar"):
                continue
            p = os.path.join(d, n)
            try:
                m = read_manifest(p)
            except Exception:
                continue
            if m.get("from_build_id") == build_id:
                found.append((p, m))
    return found


def local_problems():
    """What in the update folders cannot be installed here, and why, so that the
    menu can say it instead of passing over it: a .tar whose manifest cannot be
    read (a download cut short, or an error page saved under the package's
    name), a package made for another build, or a package-like file that is not
    a .tar. A package for the build already installed is no problem."""
    rel = release()
    out = []
    for d in LOCAL_DIRS:
        if not os.path.isdir(d):
            continue
        for n in sorted(os.listdir(d)):
            p = os.path.join(d, n)
            if not os.path.isfile(p):
                continue
            size = os.path.getsize(p)
            if not n.endswith(".tar"):
                if "_ota_" in n:
                    out.append((p, "not-tar", "%d bytes" % size))
                continue
            try:
                m = read_manifest(p)
            except Exception:
                out.append((p, "damaged", "%d bytes" % size))
                continue
            if m.get("from_build_id") == rel["BUILD_ID"] or m.get("build_id") == rel["BUILD_ID"]:
                continue
            out.append((p, "other-build", "%s (%s) to %s (%s)" % (
                m.get("from_version", "?"), m.get("from_build_id", "?"),
                m.get("version", "?"), m.get("build_id", "?"))))
    return out


def dl_dir():
    """Downloads go to a subvolume of their own, so that the snapshot of /
    taken before an update does not pin them."""
    d = os.path.join(WORK_DIR, "dl")
    if not os.path.isdir(d):
        os.makedirs(WORK_DIR, exist_ok=True)
        if subprocess.run(["btrfs", "subvolume", "create", d],
                          capture_output=True).returncode != 0:
            os.makedirs(d, exist_ok=True)
    return d


def download(entry):
    dst = os.path.join(dl_dir(), entry["filename"])
    need = int(entry.get("size", 0))
    if os.path.exists(dst) and os.path.getsize(dst) == need and \
            sha256_file(dst) == entry["sha256"]:
        log("already downloaded: " + dst)
        return dst
    make_room(need * 3 + (200 << 20))
    if free_bytes("/") < need * 3 + (200 << 20):
        raise OtaError("not enough space on the root filesystem: the update "
                       "needs about %d MiB" % ((need * 3) >> 20))
    part = dst + ".part"
    log("downloading %s (%d MiB)" % (entry["url"], need >> 20))
    have = os.path.getsize(part) if os.path.exists(part) else 0
    req = urllib.request.Request(entry["url"], headers={"User-Agent": "darkos-ota"})
    if have:
        req.add_header("Range", "bytes=%d-" % have)
    with urllib.request.urlopen(req, timeout=120) as r:
        mode = "ab" if have and r.status == 206 else "wb"
        done = have if mode == "ab" else 0
        last = 0
        with open(part, mode) as f:
            while True:
                b = r.read(1 << 20)
                if not b:
                    break
                f.write(b)
                done += len(b)
                if need and time.time() - last > 2:
                    last = time.time()
                    print("PROGRESS %d" % (done * 100 // need), flush=True)
    if sha256_file(part) != entry["sha256"]:
        os.unlink(part)
        raise OtaError("the downloaded package is damaged (sha256 mismatch); "
                       "try again")
    os.replace(part, dst)
    return dst


# ---------------------------------------------------------------- package

def read_manifest(pkg):
    with tarfile.open(pkg, "r:") as t:
        m = json.load(t.extractfile("manifest.json"))
    if m.get("format") != FORMAT:
        raise OtaError("package format %s is not supported by this updater"
                       % m.get("format"))
    return m


def boot_protected(path):
    name = path.split("/")[-1]
    return "/" not in path and any(fnmatch.fnmatch(name, p)
                                   for p in BOOT_PROTECTED)


def target(entry):
    base = "/" if entry["part"] == "root" else "/boot/"
    return base + entry["path"]


def plan(m):
    """Decide per entry: apply, skip (already new), keep (user changed it, the
    new file goes beside it), or force (system file changed by hand)."""
    dual = is_dualboot()
    out = []
    for e in m["files"]:
        if e["part"] == "boot" and dual and boot_protected(e["path"]):
            out.append(("protected", e))
            continue
        cur = current_hash(target(e))
        new = e.get("sha256")
        if e["type"] == "dir":
            out.append(("apply", e))
        elif cur == new and not e.get("meta"):
            out.append(("skip", e))
        elif cur == e.get("old_sha256") or (cur is None and e.get("old_sha256") is None):
            out.append(("apply", e))
        elif e["part"] == "root" and any(e["path"].startswith(p) for p in USER_PREFIXES):
            out.append(("keep", e))
        else:
            out.append(("force", e))
    dels = []
    for e in m.get("delete", []):
        if e["part"] == "boot" and dual and boot_protected(e["path"]):
            continue
        cur = current_hash(target(e))
        if cur is None:
            continue
        if e["part"] == "root" and any(e["path"].startswith(p) for p in USER_PREFIXES) \
                and e.get("old_sha256") not in (None, cur):
            dels.append(("keep", e))
        else:
            dels.append(("apply", e))
    return out, dels


def verify_payload(pkg, m, stage):
    """Unpack the payload into stage (on the root filesystem, so that files
    move into place with a rename) and check every file against the
    manifest."""
    if os.path.exists(stage):
        shutil.rmtree(stage)
    os.makedirs(stage)
    with tarfile.open(pkg, "r:") as t:
        names = t.getnames()
        if "payload.tar.zst" in names:
            t.extract("payload.tar.zst", stage, filter="fully_trusted")
        for n in names:
            if n == "uboot.img" or n.startswith("hooks/"):
                t.extract(n, stage, filter="fully_trusted")
    pz = os.path.join(stage, "payload.tar.zst")
    if os.path.exists(pz):
        if sha256_file(pz) != m["payload_sha256"]:
            raise OtaError("payload sha256 mismatch")
        subprocess.run(["tar", "--zstd", "-x", "-p", "--numeric-owner",
                        "-f", pz, "-C", stage], check=True)
        os.unlink(pz)
    for e in m["files"]:
        if e["type"] == "file" and not e.get("meta"):
            p = os.path.join(stage, e["part"], e["path"])
            if not os.path.isfile(p) or sha256_file(p) != e["sha256"]:
                raise OtaError("damaged file in the package: " + e["path"])
    if m.get("uboot"):
        if sha256_file(os.path.join(stage, "uboot.img")) != m["uboot"]["sha256"]:
            raise OtaError("damaged boot loader in the package")


def set_meta(path, e, follow=False):
    if e["type"] == "link":
        os.lchown(path, e["uid"], e["gid"])
        return
    if e["part"] == "root":
        os.chown(path, e["uid"], e["gid"])
        os.chmod(path, e["mode"])


def put(e, stage, journal, beside=False):
    dst = target(e)
    if beside:
        dst += ".ota-new"
    parent = os.path.dirname(dst)
    os.makedirs(parent, exist_ok=True)
    if e["type"] == "dir":
        if os.path.islink(dst) or (os.path.exists(dst) and not os.path.isdir(dst)):
            journal.append(("replaced", dst))
            os.unlink(dst)
        if not os.path.isdir(dst):
            os.mkdir(dst)
            journal.append(("created", dst))
        set_meta(dst, e)
        return
    tmp = os.path.join(parent, ".ota-tmp." + os.path.basename(dst))
    if os.path.lexists(tmp):
        os.unlink(tmp)
    if e["type"] == "link":
        os.symlink(e["target"], tmp)
    elif e.get("meta"):
        if not os.path.exists(dst):
            return
        journal.append(("replaced", dst))
        set_meta(dst, e)
        return
    else:
        src = os.path.join(stage, e["part"], e["path"])
        if e["part"] == "root":
            try:
                os.link(src, tmp)
            except OSError:
                shutil.copy2(src, tmp)
        else:
            shutil.copyfile(src, tmp)
            with open(tmp, "rb+") as f:
                os.fsync(f.fileno())
    set_meta(tmp, e)
    if os.path.isdir(dst) and not os.path.islink(dst):
        shutil.rmtree(dst)
    existed = os.path.lexists(dst)
    os.replace(tmp, dst)
    journal.append(("replaced" if existed else "created", dst))


def remove(e, journal):
    p = target(e)
    if os.path.isdir(p) and not os.path.islink(p):
        try:
            os.rmdir(p)
        except OSError:
            return
    else:
        os.unlink(p)
    journal.append(("deleted", p))


# ---------------------------------------------------------------- snapshot

def snapshots():
    return sorted(p for p in ("/" + n for n in os.listdir("/"))
                  if p.startswith(SNAP_PREFIX))


def drop_snapshots(keep=None):
    for s in snapshots():
        if s != keep:
            subprocess.run(["btrfs", "subvolume", "delete", s],
                           capture_output=True)


def make_room(need):
    """The snapshot of the update before goes when this one starts
    (take_snapshot), but it still pins the files that update replaced: on a
    full root filesystem they can be the space this one needs. Dropped first
    then, unless an update is half applied and it is the way back."""
    if free_bytes("/") >= need or not snapshots() or \
            load_state().get("status") == "applying":
        return
    log("not enough space on the root filesystem: dropping %s"
        % " ".join(snapshots()))
    drop_snapshots()
    # the space comes back once btrfs's cleaner has gone through them, and it
    # starts on them at the next commit (on the console: half a minute later)
    for c in (["filesystem", "sync"], ["subvolume", "sync"], ["filesystem", "sync"]):
        subprocess.run(["btrfs"] + c + ["/"], capture_output=True)


def take_snapshot(build_id):
    snap = SNAP_PREFIX + build_id
    drop_snapshots()
    r = subprocess.run(["btrfs", "subvolume", "snapshot", "-r", "/", snap],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise OtaError("cannot snapshot the root filesystem: "
                       + (r.stderr or r.stdout).strip())
    return snap


def backup_boot(entries, dels, dest):
    if os.path.exists(dest):
        shutil.rmtree(dest)
    os.makedirs(dest)
    saved = []
    for e in [x for _, x in entries] + [x for _, x in dels]:
        if e["part"] != "boot":
            continue
        p = target(e)
        if os.path.isfile(p):
            b = os.path.join(dest, e["path"])
            os.makedirs(os.path.dirname(b), exist_ok=True)
            shutil.copy2(p, b)
            saved.append(e["path"])
    return saved


def restore(state):
    """Put back what an update changed: root files from the snapshot, boot
    files from the copy taken before, new files removed."""
    snap = state["snapshot"]
    if not os.path.isdir(snap):
        raise OtaError("the snapshot %s is gone; nothing to restore from" % snap)
    # files a hook merged into (hooks/all-merge-dpkg.sh lists them), changed
    # after everything in the journal
    try:
        merged = [("replaced", p) for p in open(MERGED_LIST).read().split("\n") if p]
    except OSError:
        merged = []
    for kind, p in merged + list(reversed(state.get("journal", []))):
        try:
            if p.startswith("/boot/"):
                rel = p[len("/boot/"):]
                b = os.path.join(state["boot_backup"], rel)
                if os.path.isfile(b):
                    tmp = os.path.join(os.path.dirname(p), ".ota-tmp." + os.path.basename(p))
                    shutil.copyfile(b, tmp)
                    os.replace(tmp, p)
                elif kind == "created" and os.path.lexists(p):
                    os.unlink(p)
                continue
            src = snap + p
            if os.path.lexists(src):
                if os.path.isdir(src) and not os.path.islink(src):
                    if os.path.lexists(p) and not os.path.isdir(p):
                        os.unlink(p)
                    if not os.path.isdir(p):
                        subprocess.run(["cp", "-a", "--reflink=auto", src, p],
                                       check=True)
                    continue
                tmp = os.path.join(os.path.dirname(p), ".ota-tmp." + os.path.basename(p))
                if os.path.lexists(tmp):
                    os.unlink(tmp)
                subprocess.run(["cp", "-a", "--reflink=auto", src, tmp], check=True)
                if os.path.isdir(p) and not os.path.islink(p):
                    shutil.rmtree(p)
                os.replace(tmp, p)
            elif os.path.lexists(p):
                if os.path.isdir(p) and not os.path.islink(p):
                    shutil.rmtree(p)
                else:
                    os.unlink(p)
        except OSError as ex:
            log("restore: %s: %s" % (p, ex))
    if state.get("uboot_backup") and os.path.exists(state["uboot_backup"]):
        write_uboot(state["uboot_backup"], state["uboot_part"])
    subprocess.run(["sync"])


def write_uboot(img, part):
    with open(img, "rb") as f:
        data = f.read()
    with open(part, "r+b") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    with open(part, "rb") as f:
        if f.read(len(data)) != data:
            raise OtaError("the boot loader did not read back as written")


def save_state(st):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = os.path.join(STATE_DIR, ".state.json")
    with open(tmp, "w") as f:
        json.dump(st, f, indent=1)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, os.path.join(STATE_DIR, "state.json"))


def load_state():
    try:
        return json.load(open(os.path.join(STATE_DIR, "state.json")))
    except (OSError, ValueError):
        return {}


# ---------------------------------------------------------------- install

def install(pkg, assume_yes=False):
    if os.geteuid() != 0:
        raise OtaError("run as root")
    rel = release()
    m = read_manifest(pkg)
    if m.get("device") != rel.get("DEVICE", "rg52mini"):
        raise OtaError("the package is for %s" % m.get("device"))
    if m.get("from_build_id") != rel["BUILD_ID"]:
        raise OtaError("the package updates build %s (%s), this is %s (%s)"
                       % (m.get("from_build_id"), m.get("from_version"),
                          rel["BUILD_ID"], rel.get("VERSION")))
    ok, cap = battery_ok(m.get("min_battery", 20))
    if not ok:
        raise OtaError("charge the battery to %d%% or connect the charger "
                       "(now %s%%)" % (m.get("min_battery", 20), cap))
    st = load_state()
    if st.get("status") == "applying":
        raise OtaError("a previous update was interrupted; run "
                       "'darkos-ota rollback' first")

    log("update %s (%s) -> %s (%s)" % (rel.get("VERSION"), rel["BUILD_ID"],
                                      m["version"], m["build_id"]))
    stage = os.path.join(WORK_DIR, "stage")
    if free_bytes("/boot") < m.get("boot_bytes", 0) + (1 << 20):
        raise OtaError("not enough space on the boot partition (%d MiB free, "
                       "%d MiB needed)" % (free_bytes("/boot") >> 20,
                                            (m.get("boot_bytes", 0) >> 20) + 1))
    need = m.get("root_bytes", 0) + (300 << 20)
    make_room(need)
    if free_bytes("/") < need:
        raise OtaError("not enough space on the root filesystem (%d MiB free, "
                       "%d MiB needed)" % (free_bytes("/") >> 20, need >> 20))
    uboot = m.get("uboot")
    uboot_part = None
    if uboot:
        if is_dualboot():
            log("boot loader: dual-boot card, it belongs to GammaOS - not touched")
            uboot = None
        else:
            uboot_part = uboot_partition()
            with open(uboot_part, "rb") as f:
                cur = hashlib.sha256(f.read(uboot["size"])).hexdigest()
            if cur == uboot["sha256"]:
                uboot = None
            elif cur != uboot["old_sha256"]:
                log("boot loader: differs from the one of %s (written by hand) "
                    "- not touched" % m["from_version"])
                uboot = None

    snap = take_snapshot(rel["BUILD_ID"])
    log("snapshot " + snap)
    if os.path.exists(MERGED_LIST):
        os.unlink(MERGED_LIST)
    shutil.rmtree(AFTER_DIR, ignore_errors=True)
    log("checking the package")
    try:
        verify_payload(pkg, m, stage)
    except Exception:
        shutil.rmtree(stage, ignore_errors=True)
        drop_snapshots()
        raise
    files, dels = plan(m)
    n = {k: sum(1 for a, _ in files if a == k) for k in
         ("apply", "skip", "keep", "force", "protected")}
    log("files: %(apply)d to write, %(skip)d already new, %(keep)d changed by "
        "the user (kept, new beside as .ota-new), %(force)d system files changed "
        "by hand (overwritten), %(protected)d of the dual-boot builder (kept)" % n)
    for a, e in files:
        if a in ("keep", "force"):
            log("  %s: /%s" % (a, e["path"]))

    bb = os.path.join(STATE_DIR, "boot-backup")
    backup_boot([x for x in files if x[0] in ("apply", "force")], dels, bb)
    state = {"status": "applying", "from_build_id": rel["BUILD_ID"],
             "from_version": rel.get("VERSION"), "to_build_id": m["build_id"],
             "to_version": m["version"], "snapshot": snap, "boot_backup": bb,
             "journal": [], "time": int(time.time())}
    if uboot:
        ub = os.path.join(STATE_DIR, "uboot-backup.img")
        with open(uboot_part, "rb") as f, open(ub, "wb") as o:
            o.write(f.read(uboot["size"]))
        state["uboot_backup"], state["uboot_part"] = ub, uboot_part
    save_state(state)

    journal = state["journal"]
    try:
        # directories first, files of the root, then the boot partition last:
        # an update cut short leaves the old kernel with a consistent root
        order = sorted((x for x in files if x[0] in ("apply", "force", "keep")),
                       key=lambda x: (x[1]["part"] == "boot", x[1]["type"] != "dir",
                                      x[1]["path"]))
        for i, (a, e) in enumerate(order):
            put(e, stage, journal, beside=(a == "keep"))
            if i % 200 == 0:
                save_state(state)
                print("PROGRESS %d" % (i * 100 // max(1, len(order))), flush=True)
        for a, e in sorted(dels, key=lambda x: x[1]["path"], reverse=True):
            if a == "apply":
                remove(e, journal)
        save_state(state)
        # packages do not carry /etc/ld.so.cache: make it for the new libraries.
        # -X leaves the links as the package wrote them, the build's: without
        # it ldconfig moves libvulkan.so.1 from the BSP loader to Debian's.
        subprocess.run(["ldconfig", "-X"])
        subprocess.run(["sync"])
        if uboot:
            log("writing the boot loader to " + uboot_part)
            write_uboot(os.path.join(stage, "uboot.img"), uboot_part)
        for h in m.get("hooks", []):
            log("hook " + h)
            env = dict(os.environ, OTA_FROM=rel.get("VERSION", ""),
                       OTA_TO=m["version"], OTA_DUALBOOT="1" if is_dualboot() else "0")
            subprocess.run(["bash", os.path.join(stage, h)], check=True, env=env)
        subprocess.run(["sync"])
    except Exception as ex:
        log("FAILED: %s - restoring" % ex)
        save_state(state)
        restore(state)
        state["status"] = "failed"
        save_state(state)
        raise OtaError("the update failed and was undone: %s" % ex)

    try:
        save_after()
    except OSError as ex:
        log("could not keep the package database as written: %s" % ex)
    state["status"] = "applied"
    save_state(state)
    shutil.rmtree(stage, ignore_errors=True)
    log("done: %s; reboot to finish" % m["version"])
    return m


# ---------------------------------------------------------------- rollback: packages

def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="surrogateescape") as f:
            return f.read()
    except OSError:
        return None


def write_text(path, text):
    """In place of path, with its owner and mode."""
    try:
        st = os.stat(path)
    except OSError:
        st = None
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = os.path.join(os.path.dirname(path), ".ota-tmp." + os.path.basename(path))
    with open(tmp, "w", encoding="utf-8", errors="surrogateescape") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    if st:
        os.chown(tmp, st.st_uid, st.st_gid)
        os.chmod(tmp, st.st_mode & 0o7777)
    os.replace(tmp, path)


def stanzas(text):
    """dpkg's or apt's database as {(Package, Architecture): entry}, in order."""
    out = {}
    for s in text.split("\n\n"):
        s = s.strip("\n")
        if not s:
            continue
        f = dict(ln.split(":", 1) for ln in s.split("\n")
                 if ln[:1] not in (" ", "\t") and ":" in ln)
        if "Package" in f:
            out[(f["Package"].strip(), f.get("Architecture", "").strip())] = s
    return out


def field(entry, name):
    for ln in (entry or "").split("\n"):
        if ln.startswith(name + ":"):
            return ln.split(":", 1)[1].strip()
    return None


def info_stem(name):
    """The package a dpkg/info file is of, as dpkg names it there (pkg or
    pkg:arch); None for anything else."""
    if name.endswith(".ota-new"):
        name = name[:-len(".ota-new")]
    return name.rsplit(".", 1)[0] if "." in name else None


def save_after():
    """The package databases as the update left them: a rollback tells by them
    what the update changed."""
    shutil.rmtree(AFTER_DIR, ignore_errors=True)
    for rel, _ in DPKG_DBS:
        if os.path.isfile("/" + rel):
            dst = os.path.join(AFTER_DIR, rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2("/" + rel, dst)


def update_changed(state, old_status, after_status):
    """Which entries the update changed, as (by entry, by package name, how):
    by the database it left (AFTER_DIR), or, for an update an updater before
    1.9 applied, which kept none, by the dpkg/info files in its journal and the
    merged list (an entry the update changed has its .md5sums changed too)."""
    if after_status is not None:
        O, A = stanzas(old_status), stanzas(after_status)
        keys = {k for k in set(O) | set(A) if O.get(k) != A.get(k)}
        names = {k[0] for k in keys}
        return (lambda k: k in keys), (lambda n: n in names), "by the update's record"
    try:
        paths = [p for p in open(MERGED_LIST).read().split("\n") if p]
    except OSError:
        paths = []
    paths += [p for _, p in state.get("journal", [])]
    stems = set()
    for p in paths:
        if os.path.dirname(p) == "/" + DPKG_INFO:
            s = info_stem(os.path.basename(p))
            if s:
                stems.add(s)
    names = {s.split(":")[0] for s in stems}
    return (lambda k: k[0] in stems or "%s:%s" % k in stems), (lambda n: n in names), \
        "by the dpkg/info files the update wrote"


def put_back(snap, p, user, root):
    """p made as in the snapshot where it is missing, or differs and is not a
    path a user edits. 1 if written."""
    s = snap + p
    live = os.path.join(root, p.lstrip("/"))
    try:
        ss = os.lstat(s)
    except OSError:
        return 0
    try:
        ls = os.lstat(live)
    except OSError:
        ls = None
    if stat.S_ISDIR(ss.st_mode):
        if ls is not None:
            return 0
        os.makedirs(live)
        shutil.copystat(s, live)
        os.chown(live, ss.st_uid, ss.st_gid)
        return 1
    if not (stat.S_ISREG(ss.st_mode) or stat.S_ISLNK(ss.st_mode)):
        return 0
    if ls is not None:
        if user:
            return 0
        if stat.S_ISLNK(ss.st_mode) and stat.S_ISLNK(ls.st_mode):
            if os.readlink(s) == os.readlink(live):
                return 0
        elif stat.S_ISREG(ss.st_mode) and stat.S_ISREG(ls.st_mode) and \
                ss.st_size == ls.st_size and \
                (ss.st_mtime_ns == ls.st_mtime_ns or sha256_file(s) == sha256_file(live)):
            return 0
    parent = os.path.dirname(live)
    os.makedirs(parent, exist_ok=True)
    tmp = os.path.join(parent, ".ota-tmp." + os.path.basename(live))
    if os.path.lexists(tmp):
        os.unlink(tmp)
    subprocess.run(["cp", "-a", "--reflink=auto", s, tmp], check=True)
    if ls is not None and stat.S_ISDIR(ls.st_mode):
        shutil.rmtree(live)
    os.replace(tmp, live)
    return 1


def rollback_packages(state, now, write=True, root="/"):
    """After an update's files are put back: its package databases are merged
    rather than put back. The old build's alone would forget what was
    installed, removed or upgraded with apt since the update, whose files stay
    as they are, or call a package installed whose files are gone. So, entry
    by entry: what the update changed goes back to the old build's, the rest
    stays as it is now. A package going back gets its files and dpkg/info from
    the snapshot where they are missing or differ (under the paths a user
    edits, only missing ones): the update's own files the journal already put
    back, but it may have been removed or upgraded since. The info files of an
    entry that goes away go too. now: the databases before the rollback."""
    snap = state["snapshot"]
    old = {rel: read_text(snap + "/" + rel) for rel, _ in DPKG_DBS}
    after = {rel: read_text(os.path.join(AFTER_DIR, rel)) for rel, _ in DPKG_DBS}
    st_rel = "var/lib/dpkg/status"
    if old[st_rel] is None or now.get(st_rel) is None:
        log("package database: nothing to merge")
        return None
    changed, changed_name, how = update_changed(state, old[st_rel], after[st_rel])
    O, D = stanzas(old[st_rel]), stanzas(now[st_rel])
    allk = sorted(set(O) | set(D))
    back = [k for k in allk if changed(k) and O.get(k) != D.get(k)]
    kept = [k for k in allk if not changed(k) and O.get(k) != D.get(k)]
    out = {}
    for rel, kind in DPKG_DBS:
        o, d = old[rel], now.get(rel)
        if o is None or d is None:
            continue
        if kind == "stanzas":
            Os, Ds = stanzas(o), stanzas(d)
            keys = list(Ds) + [k for k in Os if k not in Ds]
            if list(Ds) == sorted(Ds):
                keys.sort()
            vals = [Os.get(k) if changed(k) else Ds.get(k) for k in keys]
            out[rel] = "".join(v + "\n\n" for v in vals if v is not None)
        else:
            def name(ln):
                return ln.rsplit(" ", 1)[-1].split(":")[0]
            lines = [ln for ln in d.splitlines() if ln and not changed_name(name(ln))] + \
                    [ln for ln in o.splitlines() if ln and changed_name(name(ln))]
            out[rel] = "".join(ln + "\n" for ln in dict.fromkeys(lines))
    log("package database: %d entries back to %s's, %d changed with apt since "
        "the update kept (what the update changed told %s)"
        % (len(back), state.get("from_version", "the old build"), len(kept), how))
    if not write:
        for title, keys, a, b in (("back", back, D, O), ("kept", kept, O, D)):
            for k in keys:
                print("  %s: %s:%s %s -> %s" % (title, k[0], k[1],
                      field(a.get(k), "Version") or "-", field(b.get(k), "Version") or "-"))
        return back, kept
    for rel, text in out.items():
        write_text(os.path.join(root, rel), text)
    # files and dpkg/info of the packages going back; info of entries going away
    want = {k for k in back if O.get(k) and "installed" in (field(O[k], "Status") or "")}
    stems = {k[0] for k in want} | {"%s:%s" % k for k in want}
    gone = {k for k in back if not O.get(k)}
    final = set(O) | set(D)
    final = {k for k in final if (O.get(k) if changed(k) else D.get(k))}
    keep_stems = {k[0] for k in final} | {"%s:%s" % k for k in final}
    gone_stems = ({k[0] for k in gone} | {"%s:%s" % k for k in gone}) - keep_stems
    n = 0
    infodir = snap + "/" + DPKG_INFO
    for nm in sorted(os.listdir(infodir)) if os.path.isdir(infodir) else []:
        if info_stem(nm) not in stems:
            continue
        n += put_back(snap, "/%s/%s" % (DPKG_INFO, nm), False, root)
        if nm.endswith(".list"):
            for p in read_text(os.path.join(infodir, nm)).splitlines():
                if p.startswith("/") and p != "/.":
                    n += put_back(snap, p, any(p[1:].startswith(u) for u in USER_PREFIXES), root)
    live_info = os.path.join(root, DPKG_INFO)
    dropped = 0
    for nm in sorted(os.listdir(live_info)) if os.path.isdir(live_info) else []:
        if info_stem(nm) in gone_stems:
            os.unlink(os.path.join(live_info, nm))
            dropped += 1
    if n or dropped:
        log("  package files put back from the snapshot: %d; dpkg/info files of "
            "entries gone: %d" % (n, dropped))
    return back, kept


def cmd_rollback(dry_run=False):
    st = load_state()
    if st.get("status") not in ("applying", "applied", "booted", "failed"):
        raise OtaError("no update to roll back")
    # the package databases as they are before anything is put back
    now = {rel: read_text("/" + rel) for rel, _ in DPKG_DBS}
    merge = st.get("status") in ("applied", "booted")
    if dry_run:
        if merge:
            rollback_packages(st, now, write=False)
        else:
            print("an update half applied: everything goes back as it was")
        return
    log("rolling back to %s (%s)" % (st.get("from_version"), st.get("from_build_id")))
    restore(st)
    if merge:
        try:
            rollback_packages(st, now)
        except Exception as ex:
            log("package database: not merged, the old build's put back (%s: %s)"
                % (type(ex).__name__, ex))
    shutil.rmtree(AFTER_DIR, ignore_errors=True)
    st["status"] = "rolled-back"
    save_state(st)
    log("rolled back; reboot")


def cmd_boot_ok():
    """At boot: an applied update is confirmed by the system having come up
    on it."""
    st = load_state()
    if st.get("status") != "applied":
        return
    rel = read_kv(RELEASE_FILE)
    if rel.get("BUILD_ID") == st.get("to_build_id"):
        st["status"] = "booted"
        log("booted %s" % st.get("to_version"))
    save_state(st)


def main():
    # sudo keeps the caller's PATH here (sudoers.d/ark-no-secure-path), and
    # ark's has no sbin: blkid, ldconfig. Hooks get this one too.
    os.environ["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    ap = argparse.ArgumentParser(prog="darkos-ota")
    ap.add_argument("--feed")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("version")
    sub.add_parser("check")
    sub.add_parser("local")
    sub.add_parser("local-problems")
    sub.add_parser("update")
    p = sub.add_parser("install")
    p.add_argument("package")
    p = sub.add_parser("rollback")
    p.add_argument("--dry-run", action="store_true",
                   help="say what would happen to the package database")
    p = sub.add_parser("next")
    p.add_argument("--build", help="instead of the update applied, or this build")
    sub.add_parser("status")
    sub.add_parser("boot-ok")
    sub.add_parser("clean")
    a = ap.parse_args()
    try:
        if a.cmd == "version":
            r = read_kv(RELEASE_FILE)
            print("%s %s" % (r.get("VERSION", "?"), r.get("BUILD_ID", "?")))
        elif a.cmd == "check":
            e = check(a.feed)
            print(json.dumps(e) if e else "none")
        elif a.cmd == "local":
            for p_, m in local_packages():
                print("%s\t%s\t%s" % (p_, m["version"], m["build_id"]))
        elif a.cmd == "local-problems":
            for p_, kind, detail in local_problems():
                print("%s\t%s\t%s" % (p_, kind, detail))
        elif a.cmd == "update":
            e = check(a.feed)
            if not e:
                print("none")
                return 0
            install(download(e))
        elif a.cmd == "install":
            install(a.package)
        elif a.cmd == "rollback":
            cmd_rollback(a.dry_run)
        elif a.cmd == "next":
            v = next_steps(a.feed, a.build)
            print(" ".join(v) if v else "none")
        elif a.cmd == "status":
            st = load_state()
            st.pop("journal", None)
            print(json.dumps(st, indent=1))
            print("snapshots: %s" % " ".join(snapshots()))
        elif a.cmd == "boot-ok":
            cmd_boot_ok()
        elif a.cmd == "clean":
            shutil.rmtree(WORK_DIR, ignore_errors=True)
            if load_state().get("status") in ("booted", "rolled-back", "failed"):
                drop_snapshots()
                shutil.rmtree(AFTER_DIR, ignore_errors=True)
    except OtaError as ex:
        log("ERROR: %s" % ex)
        return 2
    except Exception as ex:
        log("ERROR: %s: %s" % (type(ex).__name__, ex))
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main())
