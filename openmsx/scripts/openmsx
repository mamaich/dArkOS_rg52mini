#!/bin/bash

if [ -f "/opt/system/Advanced/Switch to main SD for Roms.sh" ]; then
  directory="roms2"
else
  directory="roms"
fi

if [[ ! -d "/$directory/bios/openmsx" ]]; then
  cp -rf /opt/openmsx/backupconfig/openmsx  /$directory/bios
fi

# A newer openMSX brings its own data (Tcl scripts, machines, extensions): put
# it over what an older one copied, but keep the settings the user saved there
# and what the user added (system ROMs).
# openMSX loads every Tcl script in share/scripts, and a newer one drops some (19.1 -> 21.0:
# eleven, _quitmenu.tcl and _osd_keyboard.tcl among them): the old scripts folder is renamed
# aside first, so only the new version's scripts load.
if ! cmp -s /opt/openmsx/backupconfig/openmsx/share/.darkos-version "/$directory/bios/openmsx/share/.darkos-version"; then
  if [ -f "/$directory/bios/openmsx/share/.darkos-version" ] && [ -d "/$directory/bios/openmsx/share/scripts" ]; then
    mv "/$directory/bios/openmsx/share/scripts" "/$directory/bios/openmsx/share/scripts.old-$(date +%Y%m%d%H%M%S)"
  fi
  tar -C /opt/openmsx/backupconfig/openmsx/share --exclude=./settings.xml -cf - . | tar -C "/$directory/bios/openmsx/share" -xof -
fi

if [[ ! -f "/$directory/bios/openmsx/openmsx.gptk" ]]; then
  cp -f /opt/openmsx/backupconfig/openmsx/openmsx.gptk /$directory/bios/openmsx/openmsx.gptk
fi

if [[ ! -f "/$directory/bios/openmsx/commands.txt" ]]; then
  cp -f /opt/openmsx/backupconfig/openmsx/commands.txt /$directory/bios/openmsx/commands.txt
fi

if [[ ! -z $(cat /etc/emulationstation/es_input.cfg | grep "190000004b4800000010000001010000") ]] || [[ -e "/dev/input/by-path/platform-gameforce-gamepad-event-joystick" ]]; then
  export HOTKEY="l3"
fi

sudo chmod 666 /dev/uinput
cd /opt/openmsx
export OPENMSX_USER_DATA="/$directory/bios/openmsx/share"
# The build links libGL.so.1 (openMSX's OpenGL renderer and GLEW); the image has no desktop
# GL, so gl4es's library stands in for it, or openmsx does not start at all (1.3.1 and before).
[ -f /usr/lib/gl4es/libGL.so.1 ] && export LD_LIBRARY_PATH=/usr/lib/gl4es${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export OPENMSX_HOME=$(dirname "$3")
export SDL_GAMECONTROLLERCONFIG_FILE="./gamecontrollerdb.txt" 
/opt/inttools/gptokeyb -1 "openmsx" -c "/$directory/bios/openmsx/openmsx.gptk" &
./openmsx -script "/$directory/bios/openmsx/commands.txt" "$3"
unset SDL_GAMECONTROLLERCONFIG_FILE
sudo kill -9 $(pidof gptokeyb)
sudo systemctl restart ogage &
printf "\033c" >> /dev/tty1
