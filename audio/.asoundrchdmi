# HDMI: the RK628's sound card. audio-switch.sh copies this file to ~/.asoundrc while a
# cable is in (and no headphones), .asoundrcbak back when it goes.
#
# Always 48 kHz to the card: at 44.1 kHz the TV lost the picture for half a second, four
# times in ten seconds, once a minute, for as long as a stream was open (ES keeps one open
# all the time, Kodi too). 44.1 kHz comes from a fractional divider of the audio PLL (HPLL
# 983.04 MHz, made for 48 kHz), 48 kHz from a whole one; Android (GammaOS) plays at 48 kHz.
pcm.hdmi48 {
    type plug
    slave {
        pcm "hw:CARD=rockchiphdmirk6,DEV=0"
        rate 48000
    }
}

pcm.!default {
    type plug
    slave.pcm "hdmi48"
}

ctl.!default {
    type hw
    card rockchiphdmirk6
}

# Kodi's audio device is "softvol" (opt/kodi/userdata/guisettings.xml), the speaker's softvol
# in .asoundrcbak. Without a device of that name here Kodi took the first card it found, the
# speaker, while HDMI was in. The card has no volume control of its own; this softvol adds a
# "Master" on it (at 100% when first made), which Kodi's sound goes through.
pcm.softvol {
    type softvol
    slave.pcm "hdmi48"
    control {
        name "Master"
        card rockchiphdmirk6
    }
}
