+void EECycleRate::UpdateMovieOverride(bool fmv_active)
+{
+	const s8 configured = GetConfigured();
+	const bool enabled = EmuConfig.Speedhacks.FullEERateForMovies && configured < 0;
+
+	if (fmv_active && enabled)
+	{
+		s_movie_off_vsyncs = 0;
+		if (!s_movie)
+		{
+			s_movie_bypass = true;
+			const bool applied = ApplyEffective(0, "a movie plays (the IPU decodes video)");
+			s_movie_bypass = false;
+			if (applied)
+			{
+				s_movie = true;
+				Console.WriteLn("EE cycle rate: full rate while a movie plays (set rate %d)", static_cast<int>(configured));
+			}
+		}
+		return;
+	}
+
+	if (!s_movie)
+		return;
+
+	// a second after the movie (at once when the setting goes off), the set rate again
+	if (enabled && ++s_movie_off_vsyncs < 60)
+		return;
+
+	s_movie_bypass = true;
+	ApplyEffective(configured, "the movie ended");
+	s_movie_bypass = false;
+	s_movie = false;
+	s_movie_off_vsyncs = 0;
+	Console.WriteLn("EE cycle rate: back to the set rate %d after the movie", static_cast<int>(configured));
+}
+
+bool EECycleRate::IsMovieOverrideActive()
+{
+	return s_movie;
+}
+
 EECycleRate::TransitionPath EECycleRate::GetLastTransitionPath()
 {
 	return s_last_path;
