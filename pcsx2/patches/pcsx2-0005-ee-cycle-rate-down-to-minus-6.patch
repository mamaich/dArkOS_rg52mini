diff --git a/pcsx2/VU0microInterp.cpp b/pcsx2/VU0microInterp.cpp
index 705429d0..a56ecf77 100644
--- a/pcsx2/VU0microInterp.cpp
+++ b/pcsx2/VU0microInterp.cpp
@@ -327,6 +327,16 @@ void InterpVU0::Execute(u32 cycles)
 		VU0.cycle -= cycle_change;
 		switch (std::min(static_cast<int>(ee_cycle_rate), static_cast<int>(cycle_change)))
 		{
+			// dArkOS: -4..-6 charge as the EE's own blocks do at them, (5 - 2 * (rate + 1)) / 4.
+			case -6: // 27%
+				cycle_change *= 3.75f;
+				break;
+			case -5: // 31%
+				cycle_change *= 3.25f;
+				break;
+			case -4: // 36%
+				cycle_change *= 2.75f;
+				break;
 			case -3: // 50%
 				cycle_change *= 2.0f;
 				break;
