 	}
 } // namespace
 
diff --git a/pcsx2/EECycleRateController.cpp b/pcsx2/EECycleRateController.cpp
index 10e05b85..ac264821 100644
--- a/pcsx2/EECycleRateController.cpp
+++ b/pcsx2/EECycleRateController.cpp
@@ -8,10 +8,13 @@
 
 namespace
 {
-	// The selector range the speedhack has always had.
-	constexpr int kMinSelector = -3;
+	// The selector range the speedhack has always had, and dArkOS's -4..-6 below it.
+	constexpr int kMinSelector = -6;
 	constexpr int kMaxSelector = 3;
 
+	// dArkOS: the governor still lowers the rate to -3 at most, as before -4..-6 were allowed.
+	constexpr int kGovernorMinSelector = -3;
+
 	// Ratios are dimensionless and mostly land under 2. This is not a plausibility
 	// check, it is a "the sampler produced garbage" check: anything past it means a
 	// counter wrapped or a divisor was near zero, and the window is thrown away
@@ -49,7 +52,7 @@ void EECycleRateController::OnApplied(s8 new_effective)
 
 s8 EECycleRateController::GetFloor() const
 {
-	const int floor = std::max<int>(kMinSelector, static_cast<int>(m_baseline) - static_cast<int>(m_policy.max_steps_down));
+	const int floor = std::max<int>(kGovernorMinSelector, static_cast<int>(m_baseline) - static_cast<int>(m_policy.max_steps_down));
 	return static_cast<s8>(std::min<int>(floor, m_baseline));
 }
 
