{
  "_comment": "What tools/upstream/check.py compares. pin: where the recipe writes our version (file relative to the dArkOS repo, a regex whose group 1 is the pin). mode: tag | commit | follow | fork | page | gitlab | path | frozen (see check.py). Keep a row in step with its recipe when a pin moves to another file. Built from the 2026-10-27 inventory.",
  "components": [
    {"name": "dArkOS_rg52mini vs bmdhacks", "mode": "fork", "repo": "mamaich/dArkOS_rg52mini", "branch": "master", "upstream": "bmdhacks:master", "note": "the port's own upstream"},
    {"name": "dArkOS (christianhaitian)", "mode": "follow", "repo": "christianhaitian/dArkOS", "note": "the original dArkOS; bmdhacks' port shares no history with it, so its changes are ported by hand"},
    {"name": "rk3566_core_builds vs christianhaitian", "mode": "fork", "repo": "mamaich/rk3566_core_builds", "branch": "master", "upstream": "christianhaitian:master", "note": "recipes and patches for most emulators"},
    {"name": "kernel_rk3562 vs bmdhacks", "mode": "fork", "repo": "mamaich/kernel_rk3562", "branch": "master", "upstream": "bmdhacks:master"},
