    {"name": "GZDoom", "mode": "tag", "repo": "ZDoom/gzdoom", "pin": {"file": "rk3562_core_builds/scripts/gzdoom.sh", "regex": "^TAG=\"([^\"]+)\""}, "tag_regex": "^g\\d+\\.\\d+\\.\\d+$", "note": "GZDoom goes on as UZDoom (UZDoom/UZDoom)"},
