+// dArkOS: the press that woke the screen (cancelled the screensaver, or woke ES from sleep).
+// Its release is part of that wake-up and goes nowhere else. Given to the views, Select's
+// release started the screensaver again (SystemView starts it when Select is let go): the
+// screen was lit only while Select was held. One window, so kept here.
+static struct
+{
+	bool active = false;
+	int device = 0;
+	InputType type = TYPE_COUNT;
+	int id = 0;
+} sWakePress;
+
+static void rememberWakePress(const Input& input)
+{
+	if (input.value == 0)
+		return;
+	sWakePress.active = true;
+	sWakePress.device = input.device;
+	sWakePress.type = input.type;
+	sWakePress.id = input.id;
+}
+
+static bool isWakeRelease(const Input& input)
+{
+	if (!sWakePress.active || input.value != 0 || input.device != sWakePress.device ||
+	    input.type != sWakePress.type || input.id != sWakePress.id)
+		return false;
+	sWakePress.active = false;
+	return true;
+}
+
 void Window::input(InputConfig* config, Input input)
 {
 	if (config->isMappedTo("system_hk", input))
@@ -238,11 +269,18 @@
