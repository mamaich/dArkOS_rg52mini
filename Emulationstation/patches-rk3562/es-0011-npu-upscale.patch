 	else
 		unsetenv("DARKOS_HIDE_PAD");
 
+	// dArkOS: NPU UPSCALE of the system (DarkosNpu.h); its launcher makes DARKOS_NPU_SR of it
+	if (DarkosNpu::offered(getSystemName()) && Settings::getInstance()->getString(getSystemName() + ".npusr") == "on")
