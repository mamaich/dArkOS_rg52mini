#!/usr/bin/env bash
# dArkOS: RetroArch built from libretro's master (/opt/retroarch-next), the second choice
# beside the release in ES's EMULATOR SETTINGS ("retroarch-next"). Its binary is named
# retroarch, so everything that looks for a running RetroArch finds it. Its retroarch.cfg and
# core options are its own, copied from the release's on its first start; the cores, BIOS,
# saves, states and the rest are the release's, by the absolute paths in that cfg (and the
# cores link that ES's -L path goes through).

R=/home/ark/.config/retroarch
N=/home/ark/.config/retroarch-next

sudo chmod 666 /dev/tty0
printf "\033c" > /dev/tty0

if [ ! -f "$N/retroarch.cfg" ]; then
  mkdir -p "$N"
  cp "$R/retroarch.cfg" "$N/retroarch.cfg"
  [ -f "$R/retroarch-core-options.cfg" ] && cp "$R/retroarch-core-options.cfg" "$N/"
fi
[ -e "$N/cores" ] || ln -s "$R/cores" "$N/cores"

# the BIOS files the core cannot start the game without, listed before RetroArch starts
# (darkos-bios-check; Options > Advanced > Disable BIOS Check turns it off)
bioscheck=/usr/local/bin/darkos-bios-check
if [ -x "$bioscheck" ] && ! "$bioscheck" ra retroarch-next "$@"; then
  exit 0
fi

# USB pads first, the console's own controls last (ra-extpads.py, as for the release)
ext=""
[ -x /usr/local/bin/ra-extpads.py ] && ext=$(/usr/local/bin/ra-extpads.py "$N")
start=$SECONDS
/opt/retroarch-next/bin/retroarch -c "$N/retroarch.cfg" ${ext:+"--appendconfig=$ext"} "$@"
rc=$?
# status 1 within seconds: the game did not load; started again with the log on, says why (as the
# release's wrapper)
if [ $rc -eq 1 ] && [ $((SECONDS - start)) -lt 10 ] && [ -x "$bioscheck" ] && "$bioscheck" enabled; then
  log=$(mktemp /tmp/retroarch-failed.XXXXXX)
  /opt/retroarch-next/bin/retroarch -c "$N/retroarch.cfg" ${ext:+"--appendconfig=$ext"} --verbose "$@" 2>&1 | tail -n 300 > "$log"
  [ "${PIPESTATUS[0]}" -eq 1 ] && "$bioscheck" failed retroarch-next "$log" "$@"
  rm -f "$log"
fi
exit $rc
